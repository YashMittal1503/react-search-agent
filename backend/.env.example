# ── LLM providers (llm-key-pool) ─────────────────────────────────────────
# Any number of keys per provider: <P>_API_KEY, <P>_API_KEY_2..N, or <P>_API_KEYS=a,b,c
# Missing providers are skipped. Keys from ONE account share that account's quota:
# set <P>_SHARED_QUOTA=true (e.g. GROQ_SHARED_QUOTA=true) so one 429 cools all of them at once.
GROQ_API_KEY=            # https://console.groq.com
GROQ_API_KEY_2=
NVIDIA_API_KEYS=         # https://build.nvidia.com
MISTRAL_API_KEY=         # https://console.mistral.ai
GEMINI_API_KEY=          # https://aistudio.google.com  (free-tier prompts may be used for training)
OPENROUTER_API_KEY=      # https://openrouter.ai
CEREBRAS_API_KEY=         # trial credit only (no lasting free tier); not used by models.yaml

# ── Search providers (all optional; DuckDuckGo + SearXNG work with no key) ─
TAVILY_API_KEY=          # https://tavily.com   1,000 free credits / month
EXA_API_KEY=             # https://exa.ai       $10 free credit / month
SEARXNG_URL=http://localhost:8888   # docker compose up searxng
JINA_API_KEY=            # optional, raises r.jina.ai reader limits

# ── Fetching ─────────────────────────────────────────────────────────────
ENABLE_BROWSER_FETCH=false   # true = crawl4ai/Playwright tier (pip install crawl4ai && crawl4ai-setup)

# ── Observability ────────────────────────────────────────────────────────
LOGFIRE_TOKEN=               # https://logfire.pydantic.dev (omit = console only)
LANGSMITH_TRACING=            # blank = on when LANGSMITH_API_KEY is set; false to disable
LANGSMITH_API_KEY=           # https://smith.langchain.com
LANGSMITH_PROJECT=react-search-agent
LANGSMITH_ENDPOINT=          # EU: https://eu.api.smith.langchain.com · APAC: https://apac.api.smith.langchain.com

# ── App ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
FRONTEND_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_DAY=60        # chat requests per IP per day
DEEP_RATE_LIMIT_PER_DAY=10   # deep-research runs per IP per day
