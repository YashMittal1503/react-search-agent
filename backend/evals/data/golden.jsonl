{"id": "rob-article-grounding", "category": "robustness", "focus": "read and cite: answer only from a fetched page", "difficulty": "medium", "smoke": true, "expected_mode": "quick", "query": "According to {FIXTURE}/article, in what year will Project Lumen launch and how wide is the mirror?", "assertions": [{"type": "contains_all", "values": ["2031", "412"]}, {"type": "must_call_tool", "value": "fetch_page"}]}
