// Golden test set for Scout (react-search-agent). One JSON object per line; lines starting with // are comments.
// {FIXTURE} is replaced with the local fixture site's URL (evals/fixtures_site.py), whose facts are fictional.
// Every item states its difficulty and the route it should take (expected_mode: quick | deep).
// Multi-turn items use `turns` instead of `query`; each turn runs in the same thread and is checked on its own.
// Robustness items carry `focus`: the exact failure mode they test. Reports show it as `robustness (focus)`.
{"id": "fact-canberra", "category": "static_fact", "difficulty": "easy", "smoke": true, "expected_mode": "quick", "query": "What is the capital of Australia?", "assertions": [{"type": "contains_any", "values": ["Canberra"]}, {"type": "min_sources", "value": 1}]}
{"id": "fact-everest", "category": "static_fact", "difficulty": "medium", "expected_mode": "quick", "query": "What is the official height of Mount Everest in metres, as announced by Nepal and China in 2020?", "assertions": [{"type": "numeric", "value": 8848.86, "tolerance": 0.01}, {"type": "min_sources", "value": 1}]}
{"id": "fact-tungsten", "category": "static_fact", "difficulty": "medium", "split": "holdout", "expected_mode": "quick", "query": "What is the chemical symbol for tungsten and where does it come from?", "assertions": [{"type": "regex", "pattern": "\\bW\\b"}, {"type": "contains_any", "values": ["wolfram"]}]}
